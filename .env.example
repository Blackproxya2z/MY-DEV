# ============================================================================
# JAHIN AZMAIN — THE CREATIVE ODYSSEY (v2.0)
# Production Environment Configuration Template (.env.example)
# NEVER commit real secrets, private keys, or service-role keys to Git.
# ============================================================================

# 1. Public Site Canonical URL (Used for SEO metadata, canonical links, CSRF check, sitemap.xml)
NEXT_PUBLIC_SITE_URL=https://jazmain.vercel.app

# ============================================================================
# 2. FIREBASE DATABASE CONFIGURATION (Recommended for Vercel Deployment)
# ============================================================================
# Option A: Cloud Firestore (Server-Side Service Account — Recommended)
# Create a Service Account in Firebase Console -> Project Settings -> Service Accounts -> Generate New Private Key
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the private_key value from your Firebase JSON file (keep quotes around it if multi-line or use \n)
FIREBASE_PRIVATE_KEY=

# Option B: Firebase Realtime Database (Alternative to Firestore)
# e.g. https://your-project-id-default-rtdb.firebaseio.com
FIREBASE_DATABASE_URL=
# Optional Realtime Database Secret or Legacy Token (if not using Service Account above)
FIREBASE_DATABASE_SECRET=

# Optional Public Firebase Web Config (Only needed if using client-side Firebase Storage/Auth SDKs)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=

# ============================================================================
# 3. ADMIN CMS AUTHENTICATION & SESSION SECURITY (Server-Only Secrets)
# ============================================================================
# Strictly enforced owner email and bootstrap passcode (verified via constant-time HMAC)
ADMIN_ALLOWED_EMAIL=azmain56@gmail.com
ADMIN_BOOTSTRAP_PASSCODE=replace-with-strong-admin-passcode
# Generate a random 64-char hex secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=replace-with-64-char-random-hmac-secret-in-production

# ============================================================================
# 4. CLOUDFLARE SECURITY & TURNSTILE BOT PROTECTION
# ============================================================================
# Create a Turnstile widget in Cloudflare Dashboard -> Turnstile -> Add Site
# Leave empty during local dev to rely on built-in honeypot + hashed IP rate limiting
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ============================================================================
# 5. OPTIONAL SUPABASE CONNECTION (Alternative to Firebase)
# ============================================================================
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
